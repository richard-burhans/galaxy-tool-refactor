{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); case \"$cmd\" in *\"git push\"*) case \"$cmd\" in *\"git commit\"*) bash \"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/qa_gate.sh\" 1>&2 || exit 2 ;; *) QA_GATE_REQUIRE_CLEAN=1 bash \"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/qa_gate.sh\" 1>&2 || exit 2 ;; esac ;; esac",
            "timeout": 600,
            "statusMessage": "Pre-push QA gate (ruff + mypy + tests)…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  }
}
